<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<!-- 資料庫連線字串-->
	<connectionStrings>
		<add name="SBLCollateralDB"
			 connectionString="Data Source=.;Initial Catalog=SBLCollateralDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	
</configuration>

